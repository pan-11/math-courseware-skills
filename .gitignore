# Track only the reviewed Skill release and its development tests.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/skills/
!/tests/
!/docs/
!/dist/

/skills/**
!/skills/math-courseware-*/
!/skills/math-courseware-*/SKILL.md
!/skills/math-courseware-*/agents/
!/skills/math-courseware-*/agents/openai.yaml
!/skills/math-courseware-*/references/
!/skills/math-courseware-*/references/*.md
!/skills/math-courseware-studio/scripts/
!/skills/math-courseware-studio/scripts/*.py
!/skills/math-courseware-studio/scripts/runtime/
!/skills/math-courseware-studio/scripts/runtime/*.py

/tests/*
!/tests/test_*.py
!/tests/fixture_factory.py
!/tests/validate_skills.py

/docs/*
!/docs/implementation-checks.md
!/docs/pptx-probe.md
!/docs/exports-probe.md
!/docs/test-results.json
!/docs/test-results.txt

/dist/*
!/dist/math-courseware-skills-0.1.0.zip
!/dist/release-manifest.json

__pycache__/
*.pyc
.env
.env.*
